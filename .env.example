# ========================================================
# FleetVision AI — Production Environment Variables Template
# Copy this file to .env and configure for your environment.
# Never commit real credentials or secrets to version control.
# ========================================================

# Production Database (Render PostgreSQL connection string)
DATABASE_URL="postgresql://username:password@hostname:5432/fleetvision_db?sslmode=require"

# Operating Mode (false = Live production database, true = Demo simulation mode)
NEXT_PUBLIC_USE_DEMO_DATA="false"

# Application Public Host URL
NEXT_PUBLIC_APP_URL="https://fleetvision-ai.onrender.com"

# Optimus AI — Google Gemini API Key (Optional)
# If omitted, Optimus AI operates in autonomous deterministic offline mode
GEMINI_API_KEY=""

# Monthly Operational AI Spend Cap (USD)
OPTIMUS_MONTHLY_BUDGET_USD="25.00"

# Runtime Environment
NODE_ENV="production"
PORT=3000
